# =============================================================================
# Configuration d'une instance déployée (docker compose)
# Copier en .env à la racine du projet, compléter, puis : docker compose up -d --build
# Ne jamais committer le fichier .env.
# =============================================================================

# --- Environnement ---
# prod : le backend refuse de démarrer si une valeur obligatoire manque
# (secret de session, Jira, SSO). Pas de connexion sans SSO.
APP_ENV=prod

# URL publique de l'instance (HTTPS obligatoire en prod : cookies "secure").
# Le TLS est terminé devant le conteneur proxy (load balancer, Traefik, Caddy...).
PUBLIC_URL=https://test-agent.example.com
HTTP_PORT=8080

# --- Secrets ---
# Générer : python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SESSION_SECRET=
POSTGRES_PASSWORD=

# --- LLM ---
LLM_PROVIDER=ollama
# Ollama de la machine hôte, d'un serveur GPU, ou du conteneur (--profile ollama) :
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_SECONDS=300

# --- Jira Cloud (compte de service, obligatoire en prod) ---
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_USER_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=

# --- SSO OIDC (obligatoire en prod) ---
# Microsoft Entra ID : https://login.microsoftonline.com/<tenant-id>/v2.0
# Redirect URI à enregistrer côté fournisseur : ${PUBLIC_URL}/api/auth/callback
AUTH_OIDC_ISSUER=
AUTH_OIDC_CLIENT_ID=
AUTH_OIDC_CLIENT_SECRET=

# --- Options (valeurs par défaut sinon, cf. backend/.env.example) ---
# DLP_MASK_ENABLED=true
# RAG_ENABLED=true
# VISION_ENABLED=false
# MAX_ATTACHMENT_SIZE_MB=15
