# =============================================================================
# Variables d'environnement pour le prototype
# Copier ce fichier en .env et ajuster les valeurs
#
# ⚠️  NE JAMAIS committer de vraies clés API dans ce fichier
# ⚠️  Toutes les données sont fictives / sandbox
# =============================================================================

# --- Application ---
APP_NAME=Test Automation Agent
DEBUG=true

# --- LLM Provider ---
# Options : "ollama" (modèle local), "mock" (réponses pré-définies pour tests)
LLM_PROVIDER=mock

# --- Ollama (si LLM_PROVIDER=ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
# llama3.1:8b (~4.9 Go) nécessite un GPU avec au moins ~6 Go de VRAM libre
# pour charger de façon fiable (sinon OOM intermittent selon la mémoire
# disponible au moment du chargement). Sur un GPU 4 Go (ex: GTX 1650),
# préférer un modèle plus petit : llama3.2:3b (~2 Go).
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_SECONDS=120

# --- LLM Defaults ---
LLM_DEFAULT_TEMPERATURE=0.3
LLM_DEFAULT_MAX_TOKENS=4096
LLM_MAX_RETRIES=2

# --- Module 3 (Test Design Agent) ---
# Plafond dédié, plus haut que LLM_DEFAULT_MAX_TOKENS : depuis le
# renforcement de la couverture (happy path + cas négatif + cas limite par
# critère fonctionnel), la sortie JSON attendue est plus longue.
TEST_DESIGN_MAX_TOKENS=6144

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///./test_automation.db

# --- Jira Sandbox (laisser vide pour utiliser le mock) ---
# JIRA_BASE_URL=https://your-sandbox.atlassian.net
# JIRA_API_TOKEN=your_sandbox_token_here
# JIRA_USER_EMAIL=your_email@example.com
JIRA_PROJECT_KEY=PROTO

# --- GitLab Sandbox (laisser vide pour utiliser le mock) ---
# GITLAB_BASE_URL=https://gitlab.com
# GITLAB_PRIVATE_TOKEN=your_sandbox_token_here
# GITLAB_PROJECT_ID=12345

# --- CORS ---
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# --- Tracking (module 6) ---
TRACKING_SYNC_INTERVAL_SECONDS=15

# --- DLP (module 2 — masquage des données personnelles avant envoi au LLM) ---
# true par défaut (protecteur) : nécessite le modèle spaCy français, à
# installer une fois : python -m spacy download fr_core_news_lg
# Mettre à false pour désactiver (ex: dépannage local sans le modèle installé).
DLP_MASK_ENABLED=true

# --- RAG (module 2 — exemples few-shot à partir des générations acceptées) ---
# true par défaut : nécessite un modèle d'embedding tiré une fois dans Ollama :
#   ollama pull nomic-embed-text
# Best-effort : sans le modèle, l'analyse continue simplement sans exemples.
RAG_ENABLED=true
EMBEDDING_MODEL=nomic-embed-text
RAG_TOP_K=3
RAG_MIN_SIMILARITY=0.72

# --- Pièces jointes (module 2 — photos/documents joints à la création) ---
# Documents (pdf/docx/xlsx/pptx/txt/md) : extraction de texte, toujours
# active, aucun modèle requis. Images : description factuelle via un modèle
# vision Ollama, désactivable si non tiré :
#   ollama pull moondream
UPLOAD_DIR=uploads
MAX_ATTACHMENT_SIZE_MB=15
VISION_ENABLED=true
VISION_MODEL=moondream

# --- Authentification SSO (module 8 — multi-utilisateur) ---
# Tant qu'AUTH_OIDC_ISSUER n'est pas renseigné, POST /api/auth/dev-login
# permet de se connecter sans SSO réel (voir docs/module_8_auth.md) — se
# désactive automatiquement dès que la config ci-dessous est complétée.
#
# Microsoft Entra ID (Microsoft 365 de l'entreprise) — voir la procédure pas
# à pas complète (App registration + politique "Authenticator sans mot de
# passe") dans docs/module_8_auth.md, section "Configuration réelle".
# AUTH_OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
# AUTH_OIDC_CLIENT_ID=<Application (client) ID de l'app registration Entra>
# AUTH_OIDC_CLIENT_SECRET=<valeur du client secret généré dans Entra>
# Enregistrer AUTH_REDIRECT_URI ci-dessous comme "Redirect URI" (plateforme
# Web) de l'app registration Entra.
AUTH_REDIRECT_URI=http://localhost:8000/api/auth/callback
FRONTEND_URL=http://localhost:5173
# ⚠️ À CHANGER pour toute utilisation au-delà de dev local sur sa propre
# machine : n'importe qui connaissant cette valeur peut forger un cookie de
# session valide pour n'importe quel compte.
AUTH_SESSION_SECRET=dev-insecure-secret-change-me-in-env-please-32-bytes-min
AUTH_SESSION_MAX_AGE_SECONDS=604800
